# Required for Gemini-powered features
GEMINI_API_KEY=

# Current default model. Override if needed.
GEMINI_MODEL=gemini-3.8-flash

# Optional local explanation mode from the original project design.
# Keep false for the easiest setup.
USE_LOCAL_EXPLANATION=false
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M

HOST=127.0.0.1
PORT=8000
